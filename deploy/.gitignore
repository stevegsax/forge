# Never commit private keys, real env files, or issued certs.
certs/ca/
certs/server/
certs/clients/
**/*.key
**/*.pem
temporal/.env
# Local dev stack: real env override + the compose-side fallback data dirs.
local-database/.env
local-database/data/
*.tfvars
!*.tfvars.example
.terraform/
*.tfstate
*.tfstate.*
