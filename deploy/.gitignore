# Never commit private keys, real env files, or issued certs.
certs/ca/
certs/server/
certs/clients/
**/*.key
**/*.pem
temporal/.env
# Local dev Postgres: real env override + the compose-side fallback data dir.
postgres/.env
postgres/data/
*.tfvars
!*.tfvars.example
.terraform/
*.tfstate
*.tfstate.*
