# Copy to .env (chmod 600). On the EC2 instance this is generated at boot from
# SSM Parameter Store by deploy/scripts/fetch-secrets.sh — do not commit a real .env.
#
# Supabase DIRECT connection (port 5432), NOT the transaction pooler (6543).
SUPABASE_HOST=db.<project-ref>.supabase.co
SUPABASE_USER=postgres
SUPABASE_TEMPORAL_PWD=__from_ssm__
