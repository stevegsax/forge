# Source this from your shell profile after editing the paths/endpoint.
# It points both the `forge` (and `ocr`) and `pbook` CLIs at the remote,
# internet-facing Temporal frontend over mutual TLS.

# The gateway endpoint (Terraform `gateway_endpoint` output), e.g. 203.0.113.10:443
export FORGE_TEMPORAL_ADDRESS="CHANGEME:443"

# --- mTLS material (the three files your operator sent you) ---
export FORGE_TEMPORAL_TLS=1
export FORGE_TEMPORAL_TLS_SERVER_CA="$HOME/.forge/certs/server-ca.crt"
export FORGE_TEMPORAL_TLS_CLIENT_CERT="$HOME/.forge/certs/$USER.crt"
export FORGE_TEMPORAL_TLS_CLIENT_KEY="$HOME/.forge/certs/$USER.key"

# When you connect by IP (not a DNS name in the cert), pin the stable server
# name that the cert carries so TLS host verification passes:
export FORGE_TEMPORAL_TLS_SERVER_NAME="temporal.forge.internal"

# --- pbook mirrors the same settings ---
export PBOOK_TEMPORAL_ADDRESS="$FORGE_TEMPORAL_ADDRESS"
export PBOOK_TEMPORAL_TLS=1
export PBOOK_TEMPORAL_TLS_SERVER_CA="$FORGE_TEMPORAL_TLS_SERVER_CA"
export PBOOK_TEMPORAL_TLS_CLIENT_CERT="$FORGE_TEMPORAL_TLS_CLIENT_CERT"
export PBOOK_TEMPORAL_TLS_CLIENT_KEY="$FORGE_TEMPORAL_TLS_CLIENT_KEY"
export PBOOK_TEMPORAL_TLS_SERVER_NAME="$FORGE_TEMPORAL_TLS_SERVER_NAME"
