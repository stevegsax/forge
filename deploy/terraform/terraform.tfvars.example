# Copy to terraform.tfvars and edit. (terraform.tfvars is git-ignored.)

region        = "us-east-1"
instance_type = "t3.large"

# mTLS is the auth gate. ["0.0.0.0/0"] relies on mTLS alone; narrowing to your
# office/VPN egress CIDRs adds defense in depth.
allowed_client_cidrs = ["0.0.0.0/0"]

# Must be globally unique.
ocr_bucket_name = "forge-ocr-blobs-CHANGEME"

with_pbook = false
repo_org   = "stevegsax"
forge_ref  = "main"
