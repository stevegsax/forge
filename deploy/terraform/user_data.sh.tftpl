#!/usr/bin/env bash
# Terraform user-data: clone forge, then hand off to bootstrap-instance.sh.
set -euxo pipefail

APP_DIR=/srv/forge-app
mkdir -p "$APP_DIR"

dnf install -y git ripgrep
command -v aws >/dev/null 2>&1 || dnf install -y awscli-2 || dnf install -y awscli || true

# IMDSv2 + region, then read the GitHub token to clone private repos.
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
REGION=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
GH_TOKEN=$(aws ssm get-parameter --with-decryption --name "${ssm_prefix}/SAX_GITHUB_TOKEN" \
  --query Parameter.Value --output text --region "$REGION")

git clone "https://x-access-token:$${GH_TOKEN}@github.com/${repo_org}/forge.git" "$APP_DIR/forge"
git -C "$APP_DIR/forge" checkout -f "${forge_ref}"

export APP_DIR
export SSM_PREFIX="${ssm_prefix}"
export FORGE_OCR_S3_BUCKET="${ocr_bucket}"
export WITH_PBOOK="${with_pbook}"
export SAXLLM_REF="${saxllm_ref}"
export SAXLLM_REPO_URL="https://x-access-token:$${GH_TOKEN}@github.com/${repo_org}/sax-llm.git"
export CONTRACTS_REPO_URL="https://x-access-token:$${GH_TOKEN}@github.com/${repo_org}/forge-contracts.git"

bash "$APP_DIR/forge/deploy/scripts/bootstrap-instance.sh"
