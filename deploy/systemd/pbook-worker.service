# /etc/systemd/system/pbook-worker.service
# Only needed if transcript ingestion (`forge ingest`) is in scope.
# Run `uv run pbook migrate` ONCE at deploy time before starting this — the
# pbook worker does NOT auto-run migrations (unlike the forge worker).
#
# Like the forge worker, this connects to the LOOPBACK Temporal frontend in
# plaintext; it polls pbook-task-queue.
[Unit]
Description=pbook worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Run unprivileged under the same forge account as the forge worker; bootstrap
# creates it and chowns the paths below.
User=forge
Group=forge
# pbook ships inside the forge checkout as the apps/pbook workspace member
# (D98); the workspace venv at the forge root provides `pbook`.
WorkingDirectory=/srv/forge-app/forge
EnvironmentFile=/etc/forge/forge.env
Environment=PBOOK_TEMPORAL_ADDRESS=127.0.0.1:7233
# HOME under the app dir (not /home) so uv's managed Python + cache resolve to a
# forge-owned, writable path that survives ProtectHome=true.
Environment=HOME=/srv/forge-app
# PBOOK_DATABASE_URL (Postgres-only store), OPENAI_API_KEY (pbook embeddings),
# and ANTHROPIC_API_KEY come from forge.env.
ExecStart=/usr/bin/env uv run pbook worker
Restart=always
RestartSec=5

# --- Hardening (T1.7). ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Writes: the app dir only (uv venv/cache under $HOME); the store is remote
# Postgres, so no /data access is needed.
ReadWritePaths=/srv/forge-app

[Install]
WantedBy=multi-user.target
