# Development worker environment profile (FORGE_ENV=dev).
#
# Copy to $XDG_CONFIG_HOME/forge/envs/dev.env (usually
# ~/.config/forge/envs/dev.env) and chmod 600. Same line-by-line KEY=VALUE
# parsing as prod (run-worker.sh, never shell-evaluated). Declares
# FORGE_ENV_TAG=dev; there is NO production acknowledgement anywhere in the dev
# path (no FORGE_PROD_ACK, and the dev tag can never satisfy the prod guard).

# --- Environment tag (must equal the plist's / shell's FORGE_ENV=dev) ---
FORGE_ENV_TAG=dev

# --- Temporal ---
# Nothing to set. Staging lane: dev workers/CLIs run on the dev server
# (127.0.0.1:7236) inside the `forge-dev` namespace, both derived from
# FORGE_ENV=dev by sax_platform.config.resolve_temporal_target — isolated from
# production's queues, schedules, and workflow ids by a different *server* as
# well as a different namespace. See sax-temporal/docs/namespaces.md.
#
# FORGE_TEMPORAL_NAMESPACE is retired and would be ignored if set.
# FORGE_TEMPORAL_ADDRESS survives as an override, but dev accepts no value
# other than :7236.
#
# `forge-dev` exists on :7236 (created 2026-07-30). The server is on :7236
# rather than the 7233 default only because this address table and
# sax-temporal's compose must move together — the legacy server that once held
# 7233 is gone.

# --- Application store (shared sax-datastores dev stack, :5432) ---
# forge's own instance is retired: databases now live on the shared stack, one
# role per project, each owning only its own database (a wrong-project URL
# fails at auth). forge_dev and forge_test are provisioned; _test exists for
# the suite, so nothing shares the dev database with the tests.
# Passwords are delivered by the sax-datastores admin
# (`make dev-url PROJECT=forge`) — never committed, never in this repo.
FORGE_DB_URL=postgresql+psycopg2://forge_dev:CHANGEME@localhost:5432/forge_dev
# pbook is its own product now (its own role, database, and credential) — it no
# longer shares forge's database via a pbk_-prefixed schema. Run
# `uv run pbook migrate` once against the empty database. Uncomment to enable
# the dev pbook worker (`make dev-url PROJECT=pbook`):
# PBOOK_DATABASE_URL=postgresql+psycopg://pbook_dev:CHANGEME@localhost:5432/pbook_dev

# --- LLM / OCR keys ---
ANTHROPIC_API_KEY=CHANGEME
# MISTRAL_API_KEY=CHANGEME
# OPENAI_API_KEY=CHANGEME

# --- Blobs: the shared dev MinIO (sax-datastores dev stack, :9000) ---
# Point boto3 at MinIO instead of real S3 (botocore honors AWS_ENDPOINT_URL_S3
# and uses path-style addressing). Set all five together so you never
# half-point at real S3. The credentials are the shared dev MinIO's, delivered
# by the sax-datastores admin; the bucket is declared in forge's registration
# and created by that stack.
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=sax-dev
AWS_SECRET_ACCESS_KEY=CHANGEME
AWS_DEFAULT_REGION=us-east-2
FORGE_OCR_S3_BUCKET=saxcapital-forge-blobs-dev

# --- Logging / observability ---
FORGE_LOG_DIR=/Users/CHANGEME/.local/state/forge/logs
FORGE_OTEL_EXPORTER=none
