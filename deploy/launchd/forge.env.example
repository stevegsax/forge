# Worker environment — copy to $XDG_CONFIG_HOME/forge/forge.env (usually
# ~/.config/forge/forge.env) and chmod 600. run-worker.sh parses this file
# line-by-line as KEY=VALUE and never shell-evaluates values (T0.7/G35) —
# no quoting needed, and `&` in a DB URL is safe. No `export`, no comments
# on value lines.

# --- Temporal (the local stack, deploy/local-stack) ---
# The forge and ocr workers both read FORGE_TEMPORAL_ADDRESS (the ocr CLI takes
# it as an env-backed option). The pbook worker reads no Temporal env var — it
# defaults to localhost:7233, the same loopback frontend, so no override is
# needed here.
FORGE_TEMPORAL_ADDRESS=127.0.0.1:7233

# --- Forge store (production: Supabase Postgres) ---
FORGE_DB_URL=postgresql+psycopg2://forge:CHANGEME@db.CHANGEME.supabase.co:5432/forge?sslmode=require

# --- LLM / OCR keys ---
# ANTHROPIC_API_KEY: required by the forge worker (and the pbook worker, if
# installed) — the Anthropic SDK reads it from the environment.
ANTHROPIC_API_KEY=CHANGEME
# MISTRAL_API_KEY: REQUIRED by the ocr worker (install.sh --with-ocr). It is
# read at startup and the worker fails fast if it is unset or empty. Leave it
# commented out when the ocr worker is not installed.
# MISTRAL_API_KEY=CHANGEME

# --- Blobs (production: real S3; the instance role is gone, so boto3 uses
# --- your ~/.aws config or explicit keys here) ---
FORGE_OCR_S3_BUCKET=CHANGEME
# FORGE_OCR_S3_PREFIX=ocr/
# AWS_ACCESS_KEY_ID=CHANGEME
# AWS_SECRET_ACCESS_KEY=CHANGEME
# AWS_DEFAULT_REGION=us-east-2

# --- Logging / observability ---
FORGE_LOG_DIR=/Users/CHANGEME/.local/state/forge/logs
FORGE_OTEL_EXPORTER=none
# FORGE_OTEL_ENDPOINT is only read when FORGE_OTEL_EXPORTER is otlp_grpc/otlp_http.
# FORGE_OTEL_ENDPOINT=http://localhost:4317

# --- pbook (only if the pbook worker is installed: install.sh --with-pbook) ---
# PBOOK_DATABASE_URL=postgresql+psycopg://pbook:CHANGEME@db.CHANGEME.supabase.co:5432/postgres?sslmode=require
# OPENAI_API_KEY=CHANGEME
