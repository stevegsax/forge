{
  // House style (owner-approved 2026-06-10):
  // - MD013 disabled: docs use one-line paragraphs and wide tables.
  // - MD060 "compact": the repo's prevailing table pipe style.
  // - MD036 punctuation extended with ")" so the development-plans
  //   task-file template's "*(Append dated entries here during
  //   implementation.)*" placeholder lines are not flagged as headings.
  // Ignored paths: third-party (.venv), generated output (diataxis),
  // historical record (archive), example corpus (docs/requirements/examples).
  "config": {
    "MD013": false,
    "MD036": {
      "punctuation": ".,;:!?。，；：！？)"
    },
    "MD060": {
      "style": "compact"
    }
  },
  "ignores": [
    ".venv/**",
    "diataxis/**",
    "archive/**",
    "docs/requirements/examples/**"
  ]
}
